<template>
	<view class="container">
		<image class="logo" src="/static/logo.png"></image>
		<text class="title">{{title}}</text>
		<view class="env-box">
			<text class="env-tag" :class="isDev ? 'env-dev' : 'env-prod'">
				{{ isDev ? '开发环境' : '生产环境' }}
			</text>
			<text class="env-url">API: {{ apiBaseUrl }}</text>
		</view>
		<view class="counter-box">
			<text class="counter-text">Count: {{ counter.count }}</text>
			<text class="counter-text">Double: {{ counter.doubleCount }}</text>
			<view class="btn-row">
				<button class="btn" @click="counter.decrement()">-</button>
				<button class="btn" @click="counter.reset()">Reset</button>
				<button class="btn" @click="counter.increment()">+</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { useCounterStore } from '@/stores/counter'
	import { isDev, API_BASE_URL } from '@/utils/env'

	const title = ref('Hello')
	const counter = useCounterStore()
	const apiBaseUrl = ref(API_BASE_URL)
</script>

