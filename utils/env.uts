// 环境配置工具类

// 环境类型
export type EnvType = 'development' | 'production'

// 当前环境（编译时通过条件编译确定）
// 在 HBuilderX 中运行时自动为 development，发行时为 production
let currentEnv: EnvType = 'development'

// #ifdef APP-PLUS || MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-KUAISHOU || MP-JD || MP-LARK || MP-TIKTOK
// 小程序和 App 环境下通过编译模式判断
currentEnv = 'development'
// #endif

// #ifndef APP-PLUS || MP-WEIXIN || MP-ALIPAY || MP-BAIDU || MP-TOUTIAO || MP-QQ || MP-KUAISHOU || MP-JD || MP-LARK || MP-TIKTOK
// H5 环境下可以使用 process.env
try {
  // @ts-ignore
  if (typeof process !== 'undefined' && process.env && process.env.VITE_APP_ENV) {
    // @ts-ignore
    currentEnv = process.env.VITE_APP_ENV === 'production' ? 'production' : 'development'
  }
} catch (e) {
  currentEnv = 'development'
}
// #endif

// 获取当前环境
export function getEnv(): EnvType {
  return currentEnv
}

// 判断是否为开发环境
export function isDev(): boolean {
  return getEnv() === 'development'
}

// 判断是否为生产环境
export function isProd(): boolean {
  return getEnv() === 'production'
}

// 环境配置接口
interface EnvConfig {
  apiBaseUrl: string
  apiTimeout: number
  debug: boolean
  appTitle: string
}

// 开发环境配置
const devConfig: EnvConfig = {
  apiBaseUrl: 'http://localhost:3000/api',
  apiTimeout: 10000,
  debug: true,
  appTitle: 'uni-app-x (Dev)'
}

// 生产环境配置
const prodConfig: EnvConfig = {
  apiBaseUrl: 'https://api.example.com/api',
  apiTimeout: 30000,
  debug: false,
  appTitle: 'uni-app-x'
}

// 获取当前环境配置
export function getEnvConfig(): EnvConfig {
  return isDev() ? devConfig : prodConfig
}

// 导出常用配置
export const env = getEnv()
export const config = getEnvConfig()
export const API_BASE_URL = config.apiBaseUrl
export const API_TIMEOUT = config.apiTimeout
export const IS_DEBUG = config.debug
export const APP_TITLE = config.appTitle
