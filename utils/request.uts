// 封装 DELETE 请求
export function del(url: string, params?: Record<string, any>): Promise<any> {
  return new Promise((resolve, reject) => {
    let fullUrl = BASE_URL + url
    if (params != null) {
      const query = Object.keys(params)
        .map((key) => `${key}=${encodeURIComponent(params[key])}`)
        .join('&')
      fullUrl += '?' + query
