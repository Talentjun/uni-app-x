    const token = getToken()
    uni.request({
      url: fullUrl,
      method: 'DELETE',
      header: {
        'Content-Type': 'application/json',
        Authorization: token != '' ? `Bearer ${token}` : '',
      },
      success: (res) => {
        if (res.statusCode === 200) {
          resolve(res.data)
        } else {
          uni.showToast({ title: '请求失败', icon: 'none' })
